# Copy to `.env` in this folder, then restart Expo.

# --- Google (native sign-in → POST /api/google-login with { token: idToken }) ---
# Required: Web client ID from Google Cloud Console (type "Web application").
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional on iOS: iOS OAuth client ID (helps native sign-in).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# iOS only: reversed client id / URL scheme for the config plugin, e.g.
# com.googleusercontent.apps.1234567890-abc... (from GoogleService-Info.plist REVERSED_CLIENT_ID).
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# --- Facebook (still uses in-app browser + /api/auth/callback/facebook if backend supports it) ---
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Google Sign-In needs a development build (`npx expo run:ios` / `run:android`), not Expo Go.
